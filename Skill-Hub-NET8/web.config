<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS ANCM (ASP.NET Core Module v2) 設定。
  發佈後此檔會出現在 publish 輸出目錄，IIS Application 實體路徑指向該目錄即可。
  ANCM out-of-process：IIS 作為前端，ANCM 啟動並管理 Kestrel 程序（不需 Task Scheduler，無 CMD 視窗）。
  若需切換為 in-process，將 hostingModel 改為 "inprocess"。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\SkillHubNet8.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="MCP_TRANSPORT" value="http" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
