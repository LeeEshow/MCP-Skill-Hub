<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS ANCM (ASP.NET Core Module v2) 設定。
  發佈後此檔會出現在 publish 輸出目錄，IIS Application 實體路徑指向該目錄即可。
  ANCM out-of-process：IIS 作為前端，ANCM 啟動並管理 Kestrel 程序（不需 Task Scheduler，無 CMD 視窗）。
  若需切換為 in-process，將 hostingModel 改為 "inprocess"。

  processPath 指向 self-contained single-file 發佈產出的 SkillHubNet8.exe 本身（.csproj 已設定
  PublishSelfContained + RuntimeIdentifier=win-x64 + PublishSingleFile，Runtime 已內嵌在 exe 裡）。
  不可再用 processPath="dotnet" + arguments=".\SkillHubNet8.dll"：那是 Framework-Dependent 部署的寫法，
  需要主機另外安裝 .NET 8 Runtime / ASP.NET Core Hosting Bundle，主機沒裝就會是 502.5
  (ANCM Out-Of-Process Startup Failure)。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\SkillHubNet8.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="MCP_TRANSPORT" value="http" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
